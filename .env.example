# Server-side session signing. Required in production; use at least 32 random characters.
AUTH_SECRET=

# Primary production identity and business data source: PostgreSQL 15.
DATABASE_URL=

# Legacy Supabase diagnostics only; production identity/tasks/Skill require DATABASE_URL.
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# Only for dedicated isolated preview builds. Never enable on a real campus deployment.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false

# Keep disabled until the real WeChat Open Platform OAuth callback is configured and accepted.
NEXT_PUBLIC_WECHAT_LOGIN_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=12000
DEEPSEEK_INPUT_COST_PER_MILLION_CENTS=
DEEPSEEK_OUTPUT_COST_PER_MILLION_CENTS=

# Baize limits: per authenticated user/minute and global/second. Fail closed on PG outage.
BAIZE_USER_RPM=10
BAIZE_GLOBAL_QPS=20

# Model invocations use separate PG-backed quotas; a live operations probe is required for modelReady.
BAIZE_MODEL_USER_QPM=30
BAIZE_MODEL_GLOBAL_QPS=20
